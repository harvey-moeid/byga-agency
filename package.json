{
  "name": "byga-agency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "check:ready": "node scripts/check-ready.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "worker:types": "wrangler types worker/bindings.d.ts --env-interface WorkerBindings --include-runtime false --strict-vars false",
    "db:migrate:local": "wrangler d1 migrations apply byga-agency --local",
    "db:migrate:remote": "wrangler d1 migrations apply byga-agency --remote",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test:e2e": "playwright test",
    "test:creative:smoke": "node scripts/smoke-creative-local.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "sharp": "0.35.5"
    },
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "jsonc-parser": "^3.3.1",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wrangler": "4.151.1"
  }
}
